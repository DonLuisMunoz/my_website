# Copy to ".env" and fill in. NEVER commit the real .env.
#
# Deploying with the CLI:  compose reads this file automatically.
# Deploying with Portainer: a git clone has no .env, so set these same names
#   as the stack's environment variables in the Portainer UI instead.
#
# ONLY TWO ARE REQUIRED: ADMIN_TOKEN and TUNNEL_NETWORK.
# Everything below them already has a working default in docker-compose.yml, so
# leaving one blank here (or leaving it out of Portainer entirely) is fine and
# means the same thing. Set them only when you want to change the default.

# Long random string. Generate one with:  python3 -c "import secrets; print(secrets.token_hex(24))"
# There is no default. The deploy fails if this is missing, on purpose.
ADMIN_TOKEN=

# The Docker network the existing cloudflared container runs on. Find it with:
#   docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' cloudflared
TUNNEL_NETWORK=

# Front-end origins allowed to call this API (no trailing slash).
# If the live domain isn't here, the browser blocks every call and the console
# shows a CORS error. This is the first thing that breaks on deploy.
ALLOWED_ORIGINS=https://luisamunoz.com,https://www.luisamunoz.com

# Max contact-form messages per IP per hour before the API returns 429.
CONTACT_MAX_PER_HOUR=5

# --- Contact form email (optional) ---
# Leave SMTP_HOST empty and messages are just stored. Read them any time with:
#   curl https://api.luisamunoz.com/api/messages -H "Authorization: Bearer $ADMIN_TOKEN"
# For Gmail, create an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=lamunoz12@gmail.com
SMTP_PASS=
CONTACT_TO=lamunoz12@gmail.com

# No TUNNEL_TOKEN. dockerHost already runs cloudflared on an existing tunnel,
# so this API joins that tunnel's network rather than starting a second one.
