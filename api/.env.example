# Copy to ".env" and fill in. NEVER commit the real .env.

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Front-end origins allowed to call this API (no trailing slash).
# Include your Cloudflare Pages domain + custom domain + local dev.
ALLOWED_ORIGINS=https://luislearns.pages.dev,https://luislearns.dev,http://127.0.0.1:5500

# --- Contact form email (optional). Leave SMTP_HOST blank to just store messages. ---
# For Gmail, create an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=lamunoz12@gmail.com
SMTP_PASS=
CONTACT_TO=lamunoz12@gmail.com

# --- Cloudflare Tunnel (only if using the cloudflared sidecar) ---
TUNNEL_TOKEN=
